+    use std::sync::{atomic::AtomicBool, mpsc as std_mpsc};
+
+    struct IdleSink;
+    impl Sink for IdleSink {
+        fn write(&mut self, _: AudioPacket, _: &mut Converter) -> SinkResult<()> {
