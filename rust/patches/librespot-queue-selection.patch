+            is_playing: true,
+            is_paused: false,
+            ..Default::default()
+        };
+        state.restore_recovery_player_state(native.clone()).unwrap();
+        assert_eq!(state.active_context, ContextType::Autoplay);
+        let context = Context {
+            uri: Some(native.context_uri.clone()),
+            pages: vec![ContextPage {
+                tracks: vec![
+                    ContextTrack {
+                        uri: Some(uri.into()),
+                        uid: Some("first".into()),
