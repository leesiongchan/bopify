+                    if let Some(started) = started.take() {
+                        started.send(()).unwrap();
+                    }
+                    pending.load(Ordering::Acquire) > limit
+                },
+                Some(&cancelled),
+                &AtomicBool::new(false),
+            );
+            done_tx.send(drained).unwrap();
