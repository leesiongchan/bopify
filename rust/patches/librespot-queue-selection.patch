+            device.name = "iPhone".into();
+            cluster.device.insert(active.into(), device);
+        }
+        cluster
+            .player_state
+            .mut_or_insert_default()
+            .track
+            .mut_or_insert_default()
+            .uri = playing_track.into();
+        cluster.transfer_data = transfer_data;
