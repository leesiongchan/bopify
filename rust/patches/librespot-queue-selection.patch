+    if generation != selection.generation {
+        return Err(QueueSelectionError::Stale);
+    }
+    let index = selection.raw_next_index as usize;
+    if index >= len {
+        return Err(QueueSelectionError::OutOfRange);
+    }
+    Ok(index)
