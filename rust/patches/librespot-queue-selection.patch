+            Ok(()) => StartupOutcome::LikedSongs,
+            Err(why) => {
+                warn!("liked songs: loading failed: {why}");
+                StartupOutcome::Nothing
+            }
+        };
+        if let Err(why) = self.notify().await {
+            warn!("liked songs: state update failed: {why}");
+        }
+        outcome
+    }
