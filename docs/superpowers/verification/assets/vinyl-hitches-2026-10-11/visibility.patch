+@MainActor extension HitchClockProbe {
+    static func coverage(_ panel: NSWindow) -> [String: Any] {
+        guard let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]],
+              let ownIndex = windows.firstIndex(where: { ($0[kCGWindowNumber as String] as? Int) == panel.windowNumber }),
+              let ownBounds = windows[ownIndex][kCGWindowBounds as String] as? NSDictionary,
+              let own = CGRect(dictionaryRepresentation: ownBounds) else { return ["available": false] }
+        var overlaps = [Double]()
+        for window in windows.prefix(ownIndex) {
+            guard (window[kCGWindowAlpha as String] as? Double ?? 0) > 0,
+                  let bounds = window[kCGWindowBounds as String] as? NSDictionary,
+                  let rect = CGRect(dictionaryRepresentation: bounds) else { continue }
+            let overlap = own.intersection(rect)
+            if !overlap.isNull { overlaps.append(overlap.width * overlap.height / (own.width * own.height)) }
+        }
+        return ["available": true, "above_window_overlap_count": overlaps.count,
+                "max_single_bounds_overlap_fraction": overlaps.max() ?? 0,
+                "frame": [own.minX, own.minY, own.width, own.height]]
+    }
+}
