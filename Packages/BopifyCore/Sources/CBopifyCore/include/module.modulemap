// The header is named inside the xcframework rather than in
// artifacts/include so it cannot desync from the archive Swift links
// against. The slice name tracks build-rust.sh, which
// builds arm64 only; a universal build renames it and this stops compiling,
// which is the loud failure to want here.
module CBopifyCore {
    header "../../../../../artifacts/BopifyCoreFFI.xcframework/macos-arm64/Headers/bopify_core.h"
    export *
}
